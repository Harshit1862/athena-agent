# Dev default (local Ollama) needs no overrides. For production, set:
# ATHENA_LLM_PROVIDER=openai_compat
# ATHENA_LLM_BASE_URL=https://your-hosted-endpoint
# ATHENA_LLM_MODEL=your-model-name
# ATHENA_LLM_API_KEY=your-key

ATHENA_LLM_PROVIDER=ollama
ATHENA_LLM_BASE_URL=http://localhost:11435
ATHENA_LLM_MODEL=qwen3:8b
ATHENA_EMBED_MODEL=nomic-embed-text
ATHENA_THINK=1
ATHENA_CTX=12288
ATHENA_MAX_STEPS=15
